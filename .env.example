# ---------------------------------------------------------------------------
# Template — copy to .env, fill in your own values, and never commit it.
# Load:  set -a; . .env; set +a
# ---------------------------------------------------------------------------

# --- Pillar 3 (load demo) --------------------------------------------------
# Semvec licence key for the REST API. Required for pillar 3 only; pillars 1
# and 2 do not need it (pillar 1 does not need Semvec at all). See NOTICE.md.
SEMVEC_LICENSE_KEY=

# --- Pillar 2 (quality harnesses) ------------------------------------------
# OpenAI-compatible LLM endpoint. Only needed for --llm / --judge and for the
# LOCOMO / LongBench-v2 harnesses; run_profile.py works air-gapped without it.
OPENAI_BASE_URL=https://your-endpoint/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model

# Optional separate judge model (LLM-as-judge). Falls back to OPENAI_* if unset.
JUDGE_OPENAI_BASE_URL=
JUDGE_OPENAI_API_KEY=
JUDGE_OPENAI_MODEL=

# --- Embedder (all pillars) ------------------------------------------------
# mpnet/768 throughout, matching the LOCOMO default.
SEMVEC_EMBEDDER_MODEL=paraphrase-multilingual-mpnet-base-v2
SEMVEC_EMBEDDER_DIM=768

# --- Optional: session backend and persistence ------------------------------
# SEMVEC_SESSION_BACKEND selects where session state lives: memory (default),
# redis, mongo, or a name an installed package contributes. Anything but
# memory makes the store authoritative, pods stateless, and removes the
# sticky-routing requirement. Keep the store inside your trust boundary.
#
# (a) default memory backend + durable SQL state. DATABASE_URL is read ONLY in
#     this combination and has NO default since 0.8.x. Needs sticky routing.
# SEMVEC_STATE_PERSIST=1
# DATABASE_URL=postgresql://user:password@localhost:5432/semvec
#
# (b) redis backend — authoritative, nothing behind it, so run it as a database
#     (appendonly yes, maxmemory-policy noeviction, backups) or semvec refuses
#     to start. Needs: pip install "semvec[redis]"
# SEMVEC_SESSION_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
#
# (c) mongo backend — authoritative, persists by default.
#     Needs: pip install "semvec[mongo]"; SEMVEC_MONGO_URI has no default.
# SEMVEC_SESSION_BACKEND=mongo
# SEMVEC_MONGO_URI=mongodb://localhost:27017
# SEMVEC_MONGO_DB=semvec
#     Opt-in server-side retrieval (needs Atlas Vector Search). NOTE: this
#     changes the ranking, not just latency — all measurements in this repo use
#     in-process retrieval.
# SEMVEC_MONGO_ITEM_SYNC=1

# --- Optional: calibrating the sizing model (pillar 1) ---------------------
# Point this at your vLLM / SGLang / TensorRT-LLM server running the target
# model on the target GPU, then use sizing/calibrate_vllm.py.
# VLLM_BASE_URL=https://your-vllm-host:port/v1
# VLLM_MODEL=Qwen/Qwen3.6-27B
