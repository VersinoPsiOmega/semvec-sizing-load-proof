# ---------------------------------------------------------------------------
# LOCOMO-aligned server retrieval config (canonical, from the Semvec docs)
# ---------------------------------------------------------------------------
# Source: semvec-docs.pages.dev/benchmarks (docs/benchmarks/index.md, running.md).
# This is the tuned configuration with which the published LOCOMO parity
# figures (LOCOMO-J ~0.605, ~87–93 % input reduction vs. full-context) were
# achieved. `semvec serve` (pillar 3) and the LOCOMO reader read these env vars.
#
# Load:  set -a; . configs/locomo_aligned.env; set +a
#
# NOTE: The cross-encoder reranking (SEMVEC_RERANK_*) loads an additional model
# (~80 MB) and costs latency. For the pure load/throughput demo (pillar 3),
# optionally comment it out; for maximum answer quality (parity proof) leave it on.

# Embedder — mpnet/768 throughout (LOCOMO default)
export LOCOMO_EMBEDDER_MODEL=paraphrase-multilingual-mpnet-base-v2
export LOCOMO_EMBEDDER_DIM=768
export SEMVEC_EMBEDDER_MODEL=paraphrase-multilingual-mpnet-base-v2
export SEMVEC_EMBEDDER_DIM=768

# Retrieval budget (tuned for answer quality)
export SEMVEC_RUN_TOP_K=30
export SEMVEC_CONTEXT_BUDGET_CHARS=20000

# Cross-encoder reranking (quality ↑, latency ↑) — optionally off for pure load demo
export SEMVEC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
export SEMVEC_RERANK_FETCH_K=100
export SEMVEC_RERANK_BATCH=64

# Experimental gates: per tuning history neutral/harmful → OFF (default)
export LOCOMO_ENTITY_BOOST=0
export LOCOMO_LITERAL_CACHE=0
export LOCOMO_REFORMAT_CONTEXT=0
export LOCOMO_2ND_RETRY=0
